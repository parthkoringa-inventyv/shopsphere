# PostgreSQL — local development only
POSTGRES_DB=shopsphere_dev
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DB?schema=public"

# Redis — local development only
REDIS_PASSWORD=replace_with_a_different_local_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API — local development
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
CORS_ORIGIN=http://localhost:4300